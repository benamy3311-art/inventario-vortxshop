rules_version = '2';

// Solo entran las personas invitadas (colección members, el id es su correo de Google).
// Los administradores invitan, cambian permisos y reinician el conteo.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(myEmail()); }
    function isMember() { return signedIn() && exists(memberPath()); }
    function isAdmin() { return isMember() && get(memberPath()).data.role == 'admin'; }
    function validQty() {
      return !('q' in request.resource.data) || (request.resource.data.q is number && request.resource.data.q >= 0);
    }
    function validProduct() {
      let p = request.resource.data;
      return p.name is string && p.name.size() > 0 && p.name.size() <= 120
        && p.kind in ['cuadro', 'silla', 'otro']
        && (!('photo' in p) || (p.photo is string && p.photo.size() < 600000));
    }

    match /members/{email} {
      allow read: if isMember() || (signedIn() && email == myEmail());
      allow create: if isAdmin() && request.resource.data.role in ['admin', 'editor'];
      allow update: if (isAdmin() && request.resource.data.role in ['admin', 'editor'])
        || (isMember() && email == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo', 'lastSeen']));
      allow delete: if isAdmin() && email != myEmail();
    }

    // Estado del conteo de cada producto: s = 'hay' | 'no' | null, q = unidades.
    match /items/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && validQty();
      allow delete: if isAdmin();
    }

    // Productos agregados desde la app (foto comprimida dentro del documento).
    match /products/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && validProduct();
      allow delete: if isAdmin() || resource.data.createdByEmail == myEmail();
    }

    match /meta/{id} {
      allow read, write: if isMember();
    }
  }
}
